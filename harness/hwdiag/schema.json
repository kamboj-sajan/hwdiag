{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamboj-sajan/hwdiag/blob/main/harness/hwdiag/schema.json",
  "title": "hwdiag result (format_version 1)",
  "description": "One JSON object per tool run. The envelope is the same for every tool; results depend on the tool.",
  "type": "object",
  "required": ["format_version", "tool", "tool_version", "timestamp", "git_commit", "host", "params", "results", "warnings"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "tool": { "enum": ["inventory", "memlat", "membw", "memtest", "perfcheck", "stress", "run"] },
    "tool_version": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "git_commit": { "type": "string", "minLength": 1 },
    "host": { "$ref": "#/$defs/host" },
    "params": { "type": "object" },
    "results": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    { "if": { "properties": { "tool": { "const": "inventory" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/inventory" } } } },
    { "if": { "properties": { "tool": { "const": "memlat" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/memlat" } } } },
    { "if": { "properties": { "tool": { "const": "membw" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/membw" } } } },
    { "if": { "properties": { "tool": { "const": "memtest" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/memtest" } } } },
    { "if": { "properties": { "tool": { "const": "perfcheck" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/perfcheck" } } } },
    { "if": { "properties": { "tool": { "const": "stress" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/stress" } } } },
    { "if": { "properties": { "tool": { "const": "run" } } }, "then": { "properties": { "results": { "$ref": "#/$defs/run" } } } }
  ],
  "$defs": {
    "num_or_null": { "type": ["number", "null"] },
    "int_or_null": { "type": ["integer", "null"] },
    "count": { "type": "integer", "minimum": 0 },
    "hex64": { "type": "string", "pattern": "^0x[0-9a-f]{16}$" },

    "host": {
      "type": "object",
      "required": ["hostname", "kernel", "cpu_model", "logical_cpus", "governor", "turbo", "smt", "compiler", "compiler_flags", "build_type"],
      "additionalProperties": false,
      "properties": {
        "hostname": { "type": "string" },
        "kernel": { "type": "string" },
        "cpu_model": { "type": "string" },
        "logical_cpus": { "type": "integer", "minimum": 1 },
        "governor": { "type": ["string", "null"] },
        "turbo": { "enum": ["on", "off", "unknown"] },
        "smt": { "enum": ["on", "off", "unknown"] },
        "compiler": { "type": "string" },
        "compiler_flags": { "type": "string" },
        "build_type": { "type": "string" }
      }
    },

    "counter_reading": {
      "description": "A perfctr reading: available=false with a reason, or the counts.",
      "type": "object",
      "required": ["available", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "groups": { "$ref": "#/$defs/count" },
        "multiplexed": { "type": "boolean" },
        "max_scale": { "type": "number" },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["raw", "scaled", "time_enabled_ns", "time_running_ns", "scale"],
            "properties": {
              "raw": { "$ref": "#/$defs/count" },
              "scaled": { "$ref": "#/$defs/num_or_null" },
              "time_enabled_ns": { "$ref": "#/$defs/count" },
              "time_running_ns": { "$ref": "#/$defs/count" },
              "scale": { "type": "number" }
            }
          }
        },
        "derived": { "type": "object", "additionalProperties": { "$ref": "#/$defs/num_or_null" } },
        "per_load": { "type": "object", "additionalProperties": { "$ref": "#/$defs/num_or_null" } },
        "dropped": { "type": "array" }
      },
      "if": { "properties": { "available": { "const": true } } },
      "then": { "required": ["groups", "multiplexed", "max_scale", "events", "derived"] }
    },
    "counter_status": {
      "type": "object",
      "required": ["available", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },

    "inventory": {
      "type": "object",
      "required": ["cpu", "topology", "caches", "frequency", "memory", "numa", "pcie", "sensors", "edac", "checks", "status"],
      "properties": {
        "cpu": {
          "type": "object",
          "required": ["vendor", "model", "logical_cpus", "flags"],
          "properties": { "flags": { "type": "array", "items": { "type": "string" } } }
        },
        "topology": {
          "type": "object",
          "required": ["sockets", "cores", "threads", "threads_per_core"],
          "properties": {
            "sockets": { "$ref": "#/$defs/count" },
            "cores": { "$ref": "#/$defs/count" },
            "threads": { "$ref": "#/$defs/count" },
            "threads_per_core": { "type": "number" }
          }
        },
        "caches": { "type": "array", "items": { "$ref": "#/$defs/cache" } },
        "frequency": {
          "type": "object",
          "required": ["available", "governor", "per_cpu"],
          "properties": {
            "available": { "type": "boolean" },
            "governor": { "type": ["string", "null"] },
            "per_cpu": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cpu", "cur_mhz", "min_mhz", "max_mhz"],
                "properties": {
                  "cpu": { "$ref": "#/$defs/count" },
                  "cur_mhz": { "$ref": "#/$defs/num_or_null" },
                  "min_mhz": { "$ref": "#/$defs/num_or_null" },
                  "max_mhz": { "$ref": "#/$defs/num_or_null" }
                }
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "required": ["total_kib", "free_kib", "available_kib", "hugepages_total", "hugepage_size_kib"],
          "additionalProperties": { "$ref": "#/$defs/count" }
        },
        "numa": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "cpus", "mem_total_kib"],
            "properties": {
              "node": { "$ref": "#/$defs/count" },
              "cpus": { "type": "array", "items": { "$ref": "#/$defs/count" } },
              "mem_total_kib": { "$ref": "#/$defs/int_or_null" }
            }
          }
        },
        "pcie": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "vendor", "device", "class", "class_name", "link"],
            "properties": {
              "link": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["cur_speed_gts", "cur_width", "max_speed_gts", "max_width"],
                    "properties": {
                      "cur_speed_gts": { "$ref": "#/$defs/num_or_null" },
                      "max_speed_gts": { "$ref": "#/$defs/num_or_null" },
                      "cur_width": { "$ref": "#/$defs/count" },
                      "max_width": { "$ref": "#/$defs/count" }
                    }
                  }
                ]
              }
            }
          }
        },
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chip", "label", "kind", "value", "unit"],
            "properties": {
              "kind": { "enum": ["temperature", "voltage"] },
              "value": { "type": "number" },
              "unit": { "enum": ["C", "V"] }
            }
          }
        },
        "edac": {
          "type": "object",
          "required": ["present", "controllers"],
          "properties": {
            "present": { "type": "boolean" },
            "controllers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "ce_count", "ue_count"],
                "properties": { "ce_count": { "$ref": "#/$defs/count" }, "ue_count": { "$ref": "#/$defs/count" } }
              }
            }
          }
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "status": { "enum": ["ok", "warn", "fail"] }
      }
    },
    "cache": {
      "type": "object",
      "required": ["level", "type", "size_bytes"],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "type": { "type": "string" },
        "size_bytes": { "$ref": "#/$defs/count" },
        "line_size": { "$ref": "#/$defs/count" }
      }
    },
    "check": {
      "type": "object",
      "required": ["level", "check", "subject", "message"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["info", "ok", "warn", "fail"] },
        "check": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" }
      }
    },

    "memlat": {
      "type": "object",
      "required": ["counters", "sysfs_caches", "curves", "dram_latency_ns", "detected_from", "detected_caches"],
      "properties": {
        "counters": { "$ref": "#/$defs/counter_status" },
        "sysfs_caches": { "type": "array", "items": { "$ref": "#/$defs/cache" } },
        "curves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/curve" } },
        "dram_latency_ns": { "$ref": "#/$defs/num_or_null" },
        "dram_size_bytes": { "$ref": "#/$defs/int_or_null" },
        "detected_from": { "type": ["string", "null"] },
        "detected_caches": { "type": "array", "items": { "$ref": "#/$defs/cache_match" } }
      }
    },
    "curve": {
      "type": "object",
      "required": ["name", "pattern", "pages", "points", "boundaries", "cache_comparison"],
      "properties": {
        "name": { "type": "string" },
        "pattern": { "enum": ["random", "sequential"] },
        "pages": { "enum": ["4k", "huge", "default"] },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["size_bytes", "steps_per_rep", "median_ns", "min_ns", "max_ns", "spread_pct", "samples_ns", "anon_huge_kib", "counters"],
            "properties": {
              "size_bytes": { "type": "integer", "minimum": 64 },
              "steps_per_rep": { "$ref": "#/$defs/count" },
              "median_ns": { "type": "number", "exclusiveMinimum": 0 },
              "min_ns": { "type": "number" },
              "max_ns": { "type": "number" },
              "spread_pct": { "$ref": "#/$defs/num_or_null" },
              "samples_ns": { "type": "array", "minItems": 1, "items": { "type": "number" } },
              "anon_huge_kib": { "$ref": "#/$defs/int_or_null" },
              "counters": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/counter_reading" }] }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["size_before", "size_after", "ns_before", "ns_after", "ratio"]
          }
        },
        "cache_comparison": { "type": "array", "items": { "$ref": "#/$defs/cache_match" } }
      }
    },
    "cache_match": {
      "type": "object",
      "required": ["detected_bytes", "level", "sysfs_bytes", "ratio"],
      "properties": {
        "detected_bytes": { "$ref": "#/$defs/count" },
        "level": { "$ref": "#/$defs/int_or_null" },
        "sysfs_bytes": { "$ref": "#/$defs/int_or_null" },
        "ratio": { "$ref": "#/$defs/num_or_null" }
      }
    },

    "membw": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["sweep", "stress"] } },
      "if": { "properties": { "mode": { "const": "sweep" } } },
      "then": {
        "required": ["runs", "peak", "validated", "counters"],
        "properties": {
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["threads", "cpus", "kernels", "validated"],
              "properties": {
                "threads": { "type": "integer", "minimum": 1 },
                "cpus": { "type": "array", "items": { "$ref": "#/$defs/count" } },
                "validated": { "type": "boolean" },
                "kernels": {
                  "type": "object",
                  "required": ["copy", "scale", "add", "triad"],
                  "additionalProperties": { "$ref": "#/$defs/bw_kernel" }
                }
              }
            }
          },
          "peak": {
            "type": "object",
            "required": ["gbs", "kernel", "threads"]
          },
          "validated": { "type": "boolean" },
          "counters": { "$ref": "#/$defs/counter_status" }
        }
      },
      "else": {
        "required": ["threads", "samples", "mean_gbs"],
        "properties": {
          "samples": {
            "type": "array",
            "items": { "type": "object", "required": ["t", "gbs"] }
          }
        }
      }
    },
    "bw_kernel": {
      "type": "object",
      "required": ["best_gbs", "median_gbs", "min_gbs", "samples_gbs", "counters"],
      "properties": {
        "best_gbs": { "type": "number", "exclusiveMinimum": 0 },
        "median_gbs": { "type": "number", "exclusiveMinimum": 0 },
        "min_gbs": { "type": "number" },
        "samples_gbs": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "counters": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/counter_reading" }] }
      }
    },

    "memtest": {
      "type": "object",
      "required": ["bytes_tested", "locked", "patterns", "total_errors", "errors", "errors_truncated", "status"],
      "properties": {
        "bytes_tested": { "type": "integer", "minimum": 8 },
        "locked": { "type": "boolean" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "pass", "errors", "seconds", "gbs"],
            "properties": {
              "name": { "enum": ["zeros", "ones", "checkerboard", "walking_ones", "walking_zeros", "address_in_address", "moving_inversions", "random"] },
              "errors": { "$ref": "#/$defs/count" },
              "seconds": { "type": "number", "minimum": 0 },
              "gbs": { "$ref": "#/$defs/num_or_null" }
            }
          }
        },
        "total_errors": { "$ref": "#/$defs/count" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "offset", "expected", "actual", "xor_mask", "flipped_bits"],
            "properties": {
              "offset": { "$ref": "#/$defs/count" },
              "expected": { "$ref": "#/$defs/hex64" },
              "actual": { "$ref": "#/$defs/hex64" },
              "xor_mask": { "$ref": "#/$defs/hex64" },
              "flipped_bits": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
              "physical_address": { "$ref": "#/$defs/int_or_null" }
            }
          }
        },
        "errors_truncated": { "type": "boolean" },
        "status": { "enum": ["pass", "fail"] }
      }
    },

    "perfcheck": {
      "type": "object",
      "required": ["elapsed_s", "counters", "group_layout"],
      "properties": {
        "elapsed_s": { "type": "number", "minimum": 0 },
        "counters": { "$ref": "#/$defs/counter_reading" },
        "group_layout": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "perf_stat": {
          "type": "object",
          "required": ["available", "reason"],
          "properties": {
            "available": { "type": "boolean" },
            "reason": { "type": ["string", "null"] },
            "events": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["perf_stat", "perfctr", "diff_pct"],
                "properties": {
                  "perf_stat": { "$ref": "#/$defs/num_or_null" },
                  "perfctr": { "$ref": "#/$defs/num_or_null" },
                  "diff_pct": { "$ref": "#/$defs/num_or_null" }
                }
              }
            },
            "tolerance_pct": { "type": "number" },
            "within_tolerance": { "type": ["boolean", "null"] }
          }
        }
      }
    },

    "stress": {
      "type": "object",
      "required": ["samples", "throttling", "summary"],
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "freq_mhz_mean", "freq_mhz_min", "freq_mhz_max", "temp_c_max", "util_pct", "gbs", "throttle_count"],
            "properties": {
              "t": { "type": "number" },
              "freq_mhz_mean": { "$ref": "#/$defs/num_or_null" },
              "freq_mhz_min": { "$ref": "#/$defs/num_or_null" },
              "freq_mhz_max": { "$ref": "#/$defs/num_or_null" },
              "temp_c_max": { "$ref": "#/$defs/num_or_null" },
              "temps_c": { "type": "object", "additionalProperties": { "type": "number" } },
              "util_pct": { "$ref": "#/$defs/num_or_null" },
              "gbs": { "$ref": "#/$defs/num_or_null" },
              "throttle_count": { "$ref": "#/$defs/int_or_null" }
            }
          }
        },
        "throttling": {
          "type": "object",
          "required": ["detected", "reasons", "baseline_mhz"],
          "properties": {
            "detected": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "baseline_mhz": { "$ref": "#/$defs/num_or_null" }
          }
        },
        "summary": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "run": {
      "type": "object",
      "required": ["suite", "files", "tools", "summary"],
      "properties": {
        "suite": { "enum": ["quick", "full"] },
        "files": { "type": "object", "additionalProperties": { "type": "string" } },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "exit_code", "seconds", "file"],
            "properties": {
              "exit_code": { "type": "integer" },
              "seconds": { "type": "number" },
              "file": { "type": ["string", "null"] }
            }
          }
        },
        "summary": { "type": "object" }
      }
    }
  }
}
